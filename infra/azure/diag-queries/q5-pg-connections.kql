AzureDiagnostics | where ResourceProvider == "MICROSOFT.DBFORPOSTGRESQL" and Category == "PostgreSQLLogs" | where TimeGenerated between (datetime(2026-11-17T08:40:00Z) .. datetime(2026-11-17T09:05:00Z)) | where Message has "connection authorized" | extend user=extract("user=([^ ]+)", 1, Message) | summarize n=count() by bin(TimeGenerated, 1m), user | order by TimeGenerated asc

ContainerAppConsoleLogs_CL | where TimeGenerated between (datetime(2026-11-17T08:40:00Z) .. datetime(2026-11-17T09:05:00Z)) | where Log_s has_any ("TooManyConnections", "too many clients", "remaining connection slots") | summarize n=count() by bin(TimeGenerated, 1m), ContainerAppName_s, RevisionName_s | order by TimeGenerated asc

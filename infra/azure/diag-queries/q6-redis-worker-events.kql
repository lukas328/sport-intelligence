ContainerAppSystemLogs_CL | where TimeGenerated between (datetime(2026-11-17T12:00:00Z) .. datetime(2026-11-18T00:00:00Z)) | where ContainerAppName_s has_any ("redis", "worker") | where Reason_s !in ("ContainerAppReady", "SyncingSecretFromAzureKeyVaultForContainerAppSucceeded", "ScaledObjectCheckFailed") | project TimeGenerated, ContainerAppName_s, RevisionName_s, ReplicaName_s, Reason_s, Log_s | order by TimeGenerated asc

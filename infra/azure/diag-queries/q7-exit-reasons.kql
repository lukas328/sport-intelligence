ContainerAppSystemLogs_CL | where TimeGenerated between (datetime(2026-11-17T12:00:00Z) .. datetime(2026-11-18T00:00:00Z)) | where Log_s has_any ("exit code", "OOMKilled", "Killing", "terminated", "probe", "Back-off") | project TimeGenerated, ContainerAppName_s, ReplicaName_s, Reason_s, Log_s | order by TimeGenerated asc

ContainerAppConsoleLogs_CL | where TimeGenerated between (datetime(2026-11-17T12:00:00Z) .. datetime(2026-11-18T00:00:00Z)) | where ContainerAppName_s has "redis" | where Log_s has_any ("Ready to accept", "Server initialized", "oO0OoO0OoO0Oo", "OOM", "maxmemory", "signal") | project TimeGenerated, ReplicaName=ContainerGroupName_s, Log_s | order by TimeGenerated asc

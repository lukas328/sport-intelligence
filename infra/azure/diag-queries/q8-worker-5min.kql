ContainerAppConsoleLogs_CL | where TimeGenerated between (datetime(2026-11-17T12:00:00Z) .. datetime(2026-11-18T00:00:00Z)) | where ContainerAppName_s has "worker" | where Log_s has_any ("worker_restart", "Connection refused", "Warm shut down", "SIGTERM", "Worker started", "warm shut down", "started with PID") | summarize n=count() by bin(TimeGenerated, 5m), ContainerAppName_s, kind=case(Log_s has "Connection refused", "refused", Log_s has "worker_restart", "restart", Log_s has "SIGTERM" or Log_s has "shut down", "sigterm", "start") | order by TimeGenerated asc

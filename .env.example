# Copy to .env for running the API/worker outside docker. All variables use the HB_ prefix.
HB_ENV=local
HB_DATABASE_URL=postgresql+asyncpg://handball_app:handball_app@localhost:5432/handball
HB_REDIS_URL=redis://localhost:6379/0
HB_S3_ENDPOINT_URL=http://localhost:9000
HB_S3_ACCESS_KEY=handball
HB_S3_SECRET_KEY=handball-secret
HB_GPU_BACKEND=local
# HB_SENTRY_DSN=
# Web (server side)
HB_API_INTERNAL_URL=http://localhost:8000
# Auth: generate real values for staging/production (the API refuses dev secrets there)
# HB_SECRET_KEY=$(python -c "import secrets; print(secrets.token_urlsafe(48))")
# HB_ENCRYPTION_KEY=$(python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# HB_COOKIE_SECURE=true
HB_MIGRATION_DATABASE_URL=postgresql+asyncpg://handball:handball@localhost:5432/handball
HB_EMAIL_BACKEND=smtp
HB_SMTP_HOST=localhost
HB_SMTP_PORT=1025
# Sign in with Google / Apple (ADR 010); buttons appear when configured
# HB_GOOGLE_CLIENT_ID=
# HB_GOOGLE_CLIENT_SECRET=
# HB_APPLE_CLIENT_ID=
# HB_APPLE_TEAM_ID=
# HB_APPLE_KEY_ID=
# HB_APPLE_PRIVATE_KEY=
# Tracing
# HB_OTEL_ENDPOINT=http://localhost:4318

# Optional: prose match summaries via the Claude API (insight templates work without it)
# HB_ANTHROPIC_API_KEY=

# Copy to .env for running the API/worker outside docker. All variables use the HB_ prefix.
HB_ENV=local
HB_DATABASE_URL=postgresql+asyncpg://handball:handball@localhost:5432/handball
HB_REDIS_URL=redis://localhost:6379/0
HB_S3_ENDPOINT_URL=http://localhost:9000
HB_S3_ACCESS_KEY=handball
HB_S3_SECRET_KEY=handball-secret
HB_GPU_BACKEND=local
# HB_SENTRY_DSN=
# Web (server side)
HB_API_INTERNAL_URL=http://localhost:8000
